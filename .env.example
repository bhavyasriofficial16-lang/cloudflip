# Copy this file to .env and fill in real values before running docker-compose or uvicorn.
# Never commit the real .env file.

# --- App ---
ENVIRONMENT=demo                 # demo | live
SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite:///./cloudflip.db

# --- Supabase Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Razorpay Billing (India - INR ₹) ---
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_MONTHLY=plan_...
RAZORPAY_PLAN_ANNUAL=plan_...

# --- Stripe Billing (International - USD $) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_METERED=price_...

FREE_PLAN_RESOURCE_LIMIT=5

# --- AWS Cloud Connection ---
USE_REAL_AWS=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROLE_ARN=

# --- Safety switch ---
SIMULATION_ONLY_MODE=true
